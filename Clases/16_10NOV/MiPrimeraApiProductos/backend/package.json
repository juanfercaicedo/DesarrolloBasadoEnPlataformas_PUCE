{
  "name": "mi-primera-api-productos",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de productos con Express y PostgreSQL",
  "main": "src/app.js",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
