    "prisma": "^7.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "supertest": "^7.3.2"
